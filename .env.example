# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real al repositorio (está en .gitignore).
# DATABASE_URL la entrega Neon (PostgreSQL). Sin ella, la API usa
# SQLite local (solicitudes.db) solo para pruebas.

DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
PORT=5000
FLASK_ENV=development
